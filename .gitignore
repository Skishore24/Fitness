# ==============================================================================
# FitTrack Root .gitignore
# ==============================================================================

# Android App Packages & Binaries (Large Files > 100MB rejected by GitHub)
apk/
*.apk
*.aab

# Node & Dependencies
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Android Build Artifacts & Caches
**/android/app/build/
**/android/build/
**/android/.gradle/
**/.gradle/
**/build/
**/local.properties
**/.cxx/
**/*.iml
**/*.hprof
**/.kotlin/

# Android Signing Keys & Credentials
*.keystore
!debug.keystore
*.jks
**/keystore.properties
!**/keystore.properties.example
**/google-services.json
!**/google-services.json.example

# Environment Secrets
.env
.env.*
!.env.example
**/backend/.env
**/FitTrack/.env

# Python Cache & Virtual Environments
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Databases
*.db
*.sqlite
*.sqlite3
backend/fittrack_local.db

# Metro & Bundler Caches
.metro/
metro-cache/

# IDE & Editor Configuration
.idea/
.vscode/
*.swp
*.swo

# OS Specific Files
.DS_Store
Thumbs.db
desktop.ini
