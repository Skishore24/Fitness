# =================================================================
# FITTRACK FASTAPI BACKEND CONFIGURATION (.env)
# =================================================================

# Server Network Host & Port
# Use 0.0.0.0 to listen on all interfaces so your physical phone can connect over Wi-Fi
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fittrack_db

# Firebase Service Account Credentials Path (Optional for dev fallback)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Keep empty or set to path if verifying real Firebase ID tokens
FIREBASE_CREDENTIALS_PATH=

# Allowed CORS Origins (Include your local development IPs and schemes)
CORS_ORIGINS=["*"]

# Environment mode: development / production
ENVIRONMENT=development
