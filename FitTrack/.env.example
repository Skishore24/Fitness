# =================================================================
# FITTRACK ENVIRONMENT CONFIGURATION (.env)
# =================================================================
# Copy this file to .env in the FitTrack directory.
# NEVER commit the real .env file with production credentials to GitHub!
# =================================================================

# -----------------------------------------------------------------
# 1. BACKEND API CONFIGURATION
# -----------------------------------------------------------------
# For Android physical phone or emulator connecting to FastAPI on laptop:
# Physical Phone on same Wi-Fi: http://<YOUR_LAPTOP_LOCAL_IP>:8000 (e.g., http://192.168.1.5:8000)
# Android Emulator on same machine: http://10.0.2.2:8000
# Local standalone mode (no backend required): leave empty or use http://localhost:8000
API_BASE_URL=http://192.168.1.5:8000

# -----------------------------------------------------------------
# 2. GOOGLE SIGN-IN & FIREBASE CONFIGURATION
# -----------------------------------------------------------------
# Android Package Name: com.fittrack
#
# Web Client ID from Google Cloud Console / Firebase Console:
# Found under Firebase Console -> Project Settings -> General -> Your apps -> Web client ID
# OR Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client (auto created by Google Service)
# NOTE: Do NOT use the Android client ID here; GoogleSignin.configure requires the WEB client ID.
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Debug Keystore SHA-1 Fingerprint (Pre-configured for local testing):
# SHA-1: 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
# SHA-256: FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
# Add these fingerprints to Firebase Console -> Project Settings -> Your Android App (com.fittrack).

# Release Keystore SHA-1 (Generated when you create your release keystore via keytool):
# Add the release SHA-1 to Firebase Console before building signed release APK.

# -----------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIG (Optional Web Fallback / Direct Config)
# -----------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyDummyKeyReplaceWithYourRealKey123
FIREBASE_AUTH_DOMAIN=fittrack-app.firebaseapp.com
FIREBASE_PROJECT_ID=fittrack-app
FIREBASE_STORAGE_BUCKET=fittrack-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890
