# Keystore configuration for FitTrack Release Build
# Copy this file to "keystore.properties" (do not commit keystore.properties to git)
# and update the values with your actual keystore credentials.

MYAPP_UPLOAD_STORE_FILE=my-release-key.keystore
MYAPP_UPLOAD_KEY_ALIAS=my-key-alias
MYAPP_UPLOAD_STORE_PASSWORD=your_keystore_password
MYAPP_UPLOAD_KEY_PASSWORD=your_key_password
